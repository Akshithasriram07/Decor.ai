APP_NAME=DecorAI API
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/decorai
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=uploads
GENERATED_DIR=generated
MAX_UPLOAD_MB=10
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=DecorAI
SMTP_USE_TLS=true

# Keep mock for a free local demo. Paid image providers are optional.
AI_PROVIDER=locked
AI_API_KEY=your-google-api-key-here
AI_MODEL=gemini-3.1-flash-image
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
XAI_BASE_URL=https://api.x.ai/v1

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMIN_EMAIL=admin@decorai.local
ADMIN_PASSWORD=your-admin-password

# Free text room understanding with Gemini; image generation remains locked.
AI_TEXT_PROVIDER=gemini
AI_TEXT_MODEL=gemini-3.8-flash
AI_TEXT_FALLBACK_MODELS=gemini-3.1-flash-lite
